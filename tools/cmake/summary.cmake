        universal_probe_trusted_fma(__v)
      else()
        universal_header_guard_value(__v ${__g})
      endif()
      string(LENGTH "${__g}" __len)
      math(EXPR __pad "43 - ${__len}")
      if(__pad LESS 1)
        set(__pad 1)
      endif()
      string(REPEAT " " ${__pad} __spaces)
      universal_status("  ${__g}${__spaces}:   ${__v}")
    endforeach()
    universal_status("")
    # UNIVERSAL_INSTRUMENT_ALL_TARGETS is declared by cmake/UniversalInstrumentation.cmake, which
    # no CMakeLists.txt currently includes. A value given on the command line is then inert, so
    # report whether the module is active separately from the value.
    if(COMMAND universal_add_instrumentation_flags)
      set(__instrument_all "${UNIVERSAL_INSTRUMENT_ALL_TARGETS}")
    elseif(DEFINED UNIVERSAL_INSTRUMENT_ALL_TARGETS)
      set(__instrument_all "${UNIVERSAL_INSTRUMENT_ALL_TARGETS} (no effect: cmake/UniversalInstrumentation.cmake not included)")
    else()
      set(__instrument_all "not declared (cmake/UniversalInstrumentation.cmake not included)")
    endif()
    universal_status("Coverage (GCC/Clang only):")
    universal_status("  UNIVERSAL_ENABLE_COVERAGE                  :   ${UNIVERSAL_ENABLE_COVERAGE}")
    universal_status("  UNIVERSAL_INSTRUMENT_ALL_TARGETS           :   ${__instrument_all}")
    universal_status("")
    universal_status("Sanitizers (GCC/Clang only):")
    universal_status("  AddressSanitizer                           :   ${UNIVERSAL_ENABLE_ASAN}")
    universal_status("  UndefinedBehaviorSanitizer                 :   ${UNIVERSAL_ENABLE_UBSAN}")
    universal_status("")
    # report the effective SIMD state: requested AND accepted by the compiler
    foreach(simd SSE3 AVX AVX2)
      if(UNIVERSAL_USE_${simd} AND COMPILER_HAS_${simd}_FLAG)
        set(universal_effective_${simd} ON)
      else()
        set(universal_effective_${simd} OFF)
      endif()
    endforeach()
    universal_status("Dependencies:")
    universal_status("  SSE3                                       :   ${universal_effective_SSE3}")
    universal_status("  AVX                                        :   ${universal_effective_AVX}")
    universal_status("  AVX2                                       :   ${universal_effective_AVX2}")
    universal_status("")
    universal_status("Utilities:")
    universal_status("  Serializer                                 :   ${UNIVERSAL_USE_SERIALIZER}")
    universal_status("")
    universal_status("Install:")
    universal_status("  Install path                               :   ${CMAKE_INSTALL_PREFIX}")
    universal_status("")
endfunction()
